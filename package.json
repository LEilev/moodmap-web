{
  "name": "moodmap-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "test": "node --experimental-vm-modules --import tsx --test tests/*.test.*",
    "check": "npm run lint && npm test && npm run build",
    "content:sync": "node scripts/sync-public-content.mjs",
    "content:check": "node scripts/sync-public-content.mjs --check",
    "prebuild": "npm run content:check"
  },
  "dependencies": {
    "@upstash/redis": "^1.35.1",
    "axios": "^1.21.1",
    "lucide-react": "^0.485.0",
    "next": "15.5.29",
    "react": "~19.1.0",
    "react-dom": "~19.1.0",
    "react-icons": "^5.5.0",
    "stripe": "^18.3.0",
    "validator": "^13.15.35",
    "zod": "^4.6.7",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.6",
    "autoprefixer": "^10.4.21",
    "postcss": "8.5.32",
    "tailwindcss": "^4.1.4",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.29",
    "@eslint/eslintrc": "^3.3.1",
    "tsx": "^4.23.15",
    "jsdom": "^31.0.0",
    "@testing-library/react": "^16.3.0",
    "typescript": "^5.9.3",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "nanoid": "3.3.20",
