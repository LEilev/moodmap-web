# Copy this file to .env.local for development. Never commit real values.
# Marketing pages and builds work without payment credentials. Service routes
# return an explicit unavailable response until their required config is present.
NEXT_PUBLIC_SITE_URL=https://moodmap-app.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Existing Stripe configuration. Keep the deployed values; do not replace live
# keys with test credentials. Use a separate environment for payment tests.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RC_STRIPE_PUBLIC_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
HMAC_SECRET=

# Optional server-only receipt key. If absent, the server derives a separate
# receipt-signing context from STRIPE_SECRET_KEY (never from the app HMAC).
RECEIPT_TOKEN_SECRET=
# Recommended if the Stripe account sells more than MoodMap. Comma-separated
# recurring Stripe price IDs, not the public Payment Link URLs.
STRIPE_PREMIUM_PRICE_IDS=

# At least one recovery secret is required for /api/stripe-catchup.
STRIPE_CATCHUP_TOKEN=
CRON_SECRET=
# Legacy names retained for existing operators; prefer CRON_SECRET/Bearer auth.
CRON_TOKEN=
CATCHUP_TOKEN=

# Transactional mail and existing outreach.
RESEND_API_KEY=
EMAIL_FROM=
BASE_URL=https://moodmap-app.com
COMPANY_POSTAL_ADDRESS=
# Obtain the signing secret for the actual Resend webhook endpoint. The old
# URL query token is no longer sufficient. Missing config fails closed.
RESEND_WEBHOOK_SECRET=
# Dedicated unsubscribe key recommended. Existing CRON_SECRET / RESEND_API_KEY
# can provide a server-only, purpose-separated fallback.
INFLUENCER_UNSUBSCRIBE_SECRET=

# Existing optional share-reward integration; signatures are always required.
RC_SECRET_API_KEY=
RC_ENTITLEMENT_ID=pro

# Version endpoint. iOS can look up the official store; Android is explicit.
MOODMAP_IOS_LATEST_VERSION=5.0.10
MOODMAP_ANDROID_LATEST_VERSION=5.0.8
MOODMAP_AUTOFETCH_IOS=true
MOODMAP_VERSION_FETCH_TIMEOUT_MS=2500
